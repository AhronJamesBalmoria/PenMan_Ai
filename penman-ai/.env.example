# Copy this file to .env and fill in the values.

# development | production
# production enables Secure cookies and HSTS.
APP_ENV=development
# Optional override; defaults to true when APP_ENV=production.
# COOKIE_SECURE=true

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Optional: enables local session verification (no Supabase call per request).
# Paste the JWT Secret (not the anon/service-role key).
SUPABASE_JWT_SECRET=

# AI providers: structure/context analysis and style metrics.
# At least one of GROQ_API_KEY / OPENROUTER_API_KEY is required; the app
# refuses to start without one.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Style drift detection (local BAAI/bge-small-en-v1.5 embeddings via FastEmbed).
# Higher values flag more drafts as drift (similarity < threshold); lower
# values only flag drastic changes. Users can reset a false positive from the
# editor ("Reset baseline").
STYLE_DRIFT_THRESHOLD=0.60

# Logging (INFO shows drift scores and AI model selection)
LOG_LEVEL=INFO

# Copy this file to .env and fill in the values.

# development | production
# production enables Secure cookies and HSTS.
APP_ENV=development

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Optional: enables local session verification (no Supabase call per request).
# Also add COOKIE_SECURE=true when serving over HTTPS.
SUPABASE_JWT_SECRET=

# Google AI Studio
GEMINI_API_KEY=
# Optional: comma-separated fallback chain.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

